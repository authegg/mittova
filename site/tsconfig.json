{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // vite.config.ts imports ./build/*.ts by full filename, which is what Vite's
    // native config loader needs in order to resolve them without bundling.
    "allowImportingTsExtensions": true,
    // theme.js is plain JavaScript on purpose — it is inlined into <head>
    // verbatim, so it must not need a transform — but it is still typechecked.
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "build", "vite.config.ts"]
}
