node_modules/
dist/
dashboard/dist/
# Build-time encode cache for the landing page's screenshots. Deliberately not
# under node_modules, so `npm ci` does not throw it away on every CI run.
site/.cache/

# Local secrets and generated config — never commit these.
.dev.vars
.dev.vars.*
# Anchored to the root on purpose. An unanchored `wrangler.jsonc` also matches
# site/wrangler.jsonc, which IS committed — it is a static site with no account
# id, no zone id and no bindings, and Workers Builds cannot deploy without it.
# Ignoring it silently produced a deploy that failed for no visible reason.
/wrangler.jsonc
# The demo's config, once filled in, carries the same account and resource ids,
# which is exactly why the demo is deployed by hand instead. Its committed
# template is wrangler.demo.example.jsonc.
/wrangler.demo.jsonc
worker-configuration.d.ts
.wrangler/

# Operator notes for a specific deployment.
RUNBOOK.local.md

.DS_Store
*.log

# Build artifacts
*.tsbuildinfo

# Agent tooling installed into this checkout — third-party content, not Mittova's
# to redistribute, and not part of the project.
.agents/
.claude/*
# ...except this project's own skills, which document how to work on it and
# belong in the repo. Everything else under .claude/skills is a symlink into a
# shared library: third-party content that must stay out of this history.
!.claude/skills/
.claude/skills/*
!.claude/skills/mittova/
!.claude/skills/git-conventions/
skills-lock.json
